{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Optimization that fixes waiting on the server after crystal break before end crystal entities are cleaned.",
  "authors": [
    "Bram",
    "Marlow"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/marlow-crystal-optimizer",
    "issues": "https://github.com/Bram1903/MarlowsCrystalOptimizer/issues",
    "sources": "https://github.com/Bram1903/MarlowsCrystalOptimizer"
  },
  "license": "MIT",
  "icon": "assets/marlows-crystal-optimizer/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.deathmotion.marlowcrystal.loader.fabric.MarlowCrystalFabric"
    ],
    "modmenu": [
      "com.deathmotion.marlowcrystal.integration.modmenu.ModMenuIntegration"
    ]
  },
  "mixins": [
    "MarlowCrystal.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "${fabric_api}": "*"
  },
  "suggests": {
    "yet_another_config_lib_v3": "*",
    "modmenu": "*"
  }
}
